# =============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - BACKEND
# =============================================================================

# Puerto del Servidor Backend
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Configuración de Supabase (PostgreSQL y Storage)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-secreta-aqui
SUPABASE_ANON_KEY=tu-clave-anonima-publica-aqui
SUPABASE_STORAGE_BUCKET_RAW=raw-excels
SUPABASE_STORAGE_BUCKET_REPORTS=processed-reports

# Conexión directa a PostgreSQL (Opcional si se usa Supabase Client)
DATABASE_URL=postgresql://postgres:tu-password@db.tu-proyecto.supabase.co:5432/postgres

# Configuración del Asistente de IA (Google Gemini / OpenAI)
AI_PROVIDER=gemini
GEMINI_API_KEY=tu-api-key-de-gemini
OPENAI_API_KEY=tu-api-key-de-openai
AI_MODEL=gemini-1.5-pro

# Configuración de n8n (Webhooks de Automatización)
N8N_WEBHOOK_URL_WORKFLOW_1=http://localhost:5678/webhook/tmo-workflow-1-procesar-reporte
N8N_WEBHOOK_URL_WORKFLOW_2=http://localhost:5678/webhook/tmo-workflow-2-validacion-ia
N8N_API_KEY=tu-token-de-autenticacion-n8n

# Configuración de Envío de Correos (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo-notificaciones@gmail.com
SMTP_PASS=tu-password-de-aplicacion-aqui
SMTP_FROM_NAME="Call Center Analytics & TMO"
SMTP_FROM_EMAIL=notificaciones-callcenter@empresa.com

# Umbral de TMO por defecto en segundos
DEFAULT_TMO_THRESHOLD=20.0
