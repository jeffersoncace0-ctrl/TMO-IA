# =============================================================================
# VARIABLES DE ENTORNO - CONFIGURACIÓN DEL SISTEMA TMO
# =============================================================================

# Django Core
SECRET_KEY=django-insecure-tmo-platform-super-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Base de Datos (Por defecto SQLite local para desarrollo rápido; configurable a PostgreSQL)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Parámetros del Negocio (TMO)
DEFAULT_TMO_THRESHOLD=20.0
CRITICAL_Z_SCORE=2.0

# Automatización y Scheduler
SCHEDULER_INTERVAL_MINUTES=60
SCHEDULER_AUTOSTART=False

# Configuración de Correo (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=True
SMTP_USE_TLS=False
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_aqui
SMTP_FROM_EMAIL=tu_correo@gmail.com
SMTP_NOTIFICATION_RECIPIENT=notificaciones@empresa.com
