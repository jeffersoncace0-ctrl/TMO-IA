        "operation": "executeQuery",
        "query": "INSERT INTO validaciones_ia (archivo_id, agente_id, tmo_evaluado_seg, umbral_aplicado_seg, resultado_regla, resultado_ia, motivo_clasificacion, recomendacion_operativa) VALUES ($1, $2, $3, $4, $5, 'CONFIRMADO_IA', $6, $7);",
        "additionalFields": {
          "queryParams": "={{ $('8. Code: Regla Determinista').item.json.fileId || 'c8fac9e0-14c0-4b8a-99f1-26d07fcedc54' }},={{ $('8. Code: Regla Determinista').item.json.agentCode }},={{ $('8. Code: Regla Determinista').item.json.tmo_evaluado }},={{ $('8. Code: Regla Determinista').item.json.umbral_aplicado }},={{ $('8. Code: Regla Determinista').item.json.resultado_regla }},={{ $json.answer }},={{ 'Seguimiento en comité de calidad y coaching de cierre' }}"
        }
      },
