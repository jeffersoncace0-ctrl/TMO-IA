    {
      "parameters": {
        "jsCode": "// Regla Determinista Inquebrantable de TMO\nconst items = $input.all();\nconst threshold = 20.0;\n\nreturn items.map(item => {\n  const agent = item.json;\n  const tmo = parseFloat(agent.ahtTmoSeconds || agent.tmo_promedio_seg || 0);\n  \n  let regla = 'ERROR_DATOS';\n  if (tmo > 0 && tmo <= threshold) {\n    regla = 'APROBADO';\n  } else if (tmo > threshold) {\n    regla = 'REQUIERE_REVISION';\n  }\n  \n  return {\n    json: {\n      ...agent,\n      tmo_evaluado: tmo,\n      umbral_aplicado: threshold,\n      resultado_regla: regla,\n      prompt_ia: `Evalúa el desempeño del agente ${agent.agentName || agent.codigo_agente}. Su TMO fue de ${tmo}s (Umbral: ${threshold}s). Regla determinista: ${regla}. Explica causas de rendimiento y sugiere acciones operativas.`\n    }\n  };\n});"
      },
      "id": "node-code-regla-determinista",
      "name": "8. Code: Regla Determinista",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1720, 180]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:4000/api/ai/ask",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "question",
              "value": "={{ $json.prompt_ia }}"
            },
            {
              "name": "fileId",
              "value": "={{ $json.fileId || 'archivo_demo' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-ai-assistant",
      "name": "9. AI Assistant: Explicabilidad & Diagnóstico",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1940, 180]
    },
    {
